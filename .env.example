# AutoHLD Configuration
# Copy this file to .env and adjust as needed.
# Most settings can also be changed directly in backend/config.py.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# "ollama" runs locally on your machine (no API cost, needs Ollama installed)
# "openai" uses the OpenAI API (costs money, needs a key, better quality)
LLM_PROVIDER=ollama

# ── Ollama settings ───────────────────────────────────────────────────────────
# Default URL for a locally running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Model to use. Smaller = faster, larger = better answers on complex documents.
#   qwen2.5:1.5b  — ~1 GB, works on most laptops, good for factual retrieval
#   llama3.2:3b   — ~2 GB, noticeably better on technical text
#   mistral:7b    — ~4 GB, best quality but needs 8+ GB RAM
OLLAMA_MODEL=qwen2.5:1.5b

# ── OpenAI settings (only used if LLM_PROVIDER=openai) ───────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
